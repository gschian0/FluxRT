# Copy to scripts/streaming/rtmp_targets.env and fill your real stream keys.
# Do not commit the real env file.

# Example format:
# YOUTUBE_RTMP_URL="rtmp://a.rtmp.youtube.com/live2/YOUR_YOUTUBE_KEY"
# TWITCH_RTMP_URL="rtmp://live.twitch.tv/app/YOUR_TWITCH_KEY"
# FACEBOOK_RTMP_URL="rtmps://live-api-s.facebook.com:443/rtmp/YOUR_FACEBOOK_KEY"

YOUTUBE_RTMP_URL=""
TWITCH_RTMP_URL=""
FACEBOOK_RTMP_URL=""

# Optional Owncast self-hosted preview (start with scripts/streaming/start_owncast_sidecar.sh)
OWNCAST_RTMP_URL="rtmp://127.0.0.1:1935/live/owncast"

# Per-platform output switches (1=enabled, 0=disabled)
ENABLE_YOUTUBE="1"
ENABLE_TWITCH="1"
ENABLE_FACEBOOK="1"
ENABLE_OWNCAST="0"
